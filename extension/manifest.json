{
  "manifest_version": 3,
  "name": "MediaVault",
  "version": "1.3.0",
  "description": "Save and resume playback progress across Netflix, anime sites, and supported streaming platforms.",
  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://mediavault-backend-vxsb.onrender.com/*",
    "https://*.anidoor.me/*",
    "https://*.vidnest.fun/*",
    "https://*.hianime.to/*",
    "https://*.crunchyroll.com/*",
    "https://*.animepahe.ru/*",
    "https://*.youtube.com/*",
    "https://*.netflix.com/*",
    "https://*.reanime.to/*",
    "https://*.anikototv.to/*",
    "https://*.miruro.to/*",
    "https://*.mkissa.to/*",
    "https://*.anizone.to/*",
    "https://*.senshi.to/*",
    "https://*.kaa.to/*",
    "https://*.aniwaves.ru/*",
    "https://*.animenexus.tv/*",
    "https://*.bilibili.tv/*",
    "https://*.bilibili.com/*",
    "https://*.anisnatch.to/*",
    "https://*.ani.pm/*",
    "https://*.animeonsen.xyz/*",
    "https://*.shiro.so/*",
    "https://*.animex.one/*",
    "https://*.anime.uniquestream.net/*",
    "https://*.anify.to/*",
    "https://*.shuttletv.pk/*", "https://*.shuttletv.su/*",
    "https://*.hydrahd.com/*", "https://*.hydrahd.me/*", "https://*.hydrahd.ru/*", "https://*.hydrahd.ws/*",
    "https://*.atlantic.st/*", "https://*.bingr.one/*", "https://*.m4uhd.to/*", "https://*.cinemaos.live/*",
    "https://*.rivestream.app/*", "https://*.rivestream.ru/*", "https://*.rivestream.vip/*", "https://*.watchroo.com/*",
    "https://*.vidbox.cc/*", "https://*.nepu.io/*", "https://*.nepu.is/*", "https://*.flixer.su/*", "https://*.hexa.su/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://*.anidoor.me/*",
        "https://*.vidnest.fun/*",
        "https://*.hianime.to/*",
        "https://*.crunchyroll.com/*",
        "https://*.animepahe.ru/*",
        "https://*.youtube.com/*",
        "https://*.netflix.com/*",
        "https://*.reanime.to/*",
        "https://*.anikototv.to/*",
        "https://*.miruro.to/*",
        "https://*.mkissa.to/*",
        "https://*.anizone.to/*",
        "https://*.senshi.to/*",
        "https://*.kaa.to/*",
        "https://*.aniwaves.ru/*",
        "https://*.animenexus.tv/*",
        "https://*.bilibili.tv/*",
        "https://*.bilibili.com/*",
        "https://*.anisnatch.to/*",
        "https://*.ani.pm/*",
        "https://*.animeonsen.xyz/*",
        "https://*.shiro.so/*",
        "https://*.animex.one/*",
        "https://*.anime.uniquestream.net/*",
        "https://*.anify.to/*",
        "https://*.shuttletv.pk/*", "https://*.shuttletv.su/*",
        "https://*.hydrahd.com/*", "https://*.hydrahd.me/*", "https://*.hydrahd.ru/*", "https://*.hydrahd.ws/*",
        "https://*.atlantic.st/*", "https://*.bingr.one/*", "https://*.m4uhd.to/*", "https://*.cinemaos.live/*",
        "https://*.rivestream.app/*", "https://*.rivestream.ru/*", "https://*.rivestream.vip/*", "https://*.watchroo.com/*",
        "https://*.vidbox.cc/*", "https://*.nepu.io/*", "https://*.nepu.is/*", "https://*.flixer.su/*", "https://*.hexa.su/*"
      ],
      "js": ["sites.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html"
  }
}
